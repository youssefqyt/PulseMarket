# ------------------------------------------------------------------
#  PulseMarket API - environment template
#  Copy to ".env" and adjust for your machine.
#      cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# PostgreSQL
# Local Postgres usually listens on 5432.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pulsemarket
# Optional: a full connection string overrides the fields above.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsemarket

# Redis (optional in development - the API degrades gracefully if it is down)
REDIS_URL=redis://localhost:6379

# Stripe hosted card checkout (optional for local development).
# Set both keys from the Stripe Dashboard; never use live keys in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Use your deployed HTTPS app/universal-link URLs for production.
STRIPE_SUCCESS_URL=pulsemarket://payment-result?result=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=pulsemarket://payment-result?result=cancelled

# Cloudinary product image uploads (optional).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT
# IMPORTANT: use long random strings in production.
JWT_ACCESS_SECRET=change-me-access-secret-please-make-it-long
JWT_REFRESH_SECRET=change-me-refresh-secret-please-make-it-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Observability (used from the Docker / CI-CD phase onward)
LOG_LEVEL=info
