# ------------------------------------------------------------------
#  PulseMarket Mobile - environment template
#  Copy to ".env" and adjust.
# ------------------------------------------------------------------

# Where the app talks to the backend.
#   Android emulator  -> http://10.0.2.2:5000   (10.0.2.2 == host localhost)
#   iOS simulator     -> http://localhost:5000
#   Physical phone    -> set this to your PC LAN IP, e.g. http://192.168.1.20:5000
# Leave blank to use the platform default (Android emulator: 10.0.2.2; iOS simulator: localhost).
EXPO_PUBLIC_API_URL=

# Optional public web/universal-link origin for wishlist sharing.
# Example: https://app.example.com
EXPO_PUBLIC_APP_URL=
